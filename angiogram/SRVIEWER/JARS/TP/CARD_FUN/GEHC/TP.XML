<?xml version="1.0" encoding="ISO-8859-1"?>

<Customizations>

<!-- Units of Measurement SI: International System of Units (S.I.) or EN: Traditional English units of measurement. -->
    <UnitsOfMeasurement name="SI"/>
<!-- Font type and size -->
    <Font type="" size=""/>
<!-- Fixed Output e.g. PDF, RTF, etc. -->
    <FixedOutput>
        <MediaSize>A4</MediaSize>
        <Orientation>Portrait</Orientation>
        <Margin unit="mm">
            <Top>10</Top>
            <Bottom>10</Bottom>
            <Left>10</Left>
            <Right>10</Right>
        </Margin>
<!-- Report footer -->
        <Footer>
            <PatientName/>
            <PatientID/>
            <PageNumber/>
            <CurrentDateTime/>
        </Footer>
    </FixedOutput>
<!-- Report header -->
    <Header>
        <Hospital>
            <Logo align="left" scale="1.0">LOGO.JPG</Logo>
            <Name align="right">LBL_YOUR_HOSPITALS_NAME</Name>
            <Address>LBL_YOUR_HOSPITALS_ADDRESS</Address>
        </Hospital>
    </Header>
<!-- Demographic information -->
    <Demographics>
        <Identification>
            <Item name="LBL_PATIENTID"         add="true" tag="0010,0020"/>
            <Item name="LBL_NAME"              add="true" tag="0010,0010"/>
            <Item name="LBL_BIRTHDATE"         add="true" tag="0010,0030"/>
            <Item name="LBL_AGE"               add="true" tag="0010,1010"/>
            <Item name="LBL_SEX"               add="true" tag="0010,0040"/>
            <Item name="LBL_ETHNIC_GROUP"      add="false" tag="0010,2160"/>
            <Item name="LBL_STUDYDATE"         add="true" tag="0008,0020"/>
            <Item name="LBL_STUDYID"           add="false" tag="0020,0010"/>
            <Item name="LBL_ACCESSION_NUMBER"  add="false" tag="0008,0050"/>
            <Item name="LBL_CONTENT_DATE"      add="true" tag="0008,0023"/>
            <Item name="LBL_COMPLETION_FLAG"   add="true" tag="0040,A491"/>
            <Item name="LBL_VERIFICATION_FLAG" add="true" tag="0040,A493"/>
        </Identification>
        <MedicalHistory>
            <Item name="LBL_WEIGHT"         add="true" tag="0010,1030"/>
            <Item name="LBL_HEIGHT"         add="true" tag="0010,1020"/>
            <Item name="LBL_BODY_SURFACE_AREA" add="true"/>
            <Item name="LBL_BODY_MASS_INDEX"   add="true"/>
            <Item name="LBL_ALLERGIES"         add="false" code="F-C30F9" scheme="SNM3"/>
            <Item name="LBL_CHOLESTEROL"       add="true" code="F-63980" scheme="SNM3"/>
            <Item name="LBL_BLOOD_PRESSURE"    add="false" code="F-31000" scheme="SNM3"/>
            <Item name="LBL_DIABETES"          add="true" code="" scheme=""/>
            <Item name="LBL_SMOKING"           add="true" code="F-93109" scheme="SNM3"/>
            <Item name="LBL_OVERWEIGHT"        add="true" code="F-02A18" scheme="SNM3"/>
            <Item name="LBL_MEDICATIONS"       add="false" code="C-50000" scheme="SNM3"/>
        </MedicalHistory>
        <PhysicianInfo>
            <Item name="LBL_ORDERING_PHYSICIAN"  add="true"/>
            <Item name="LBL_REFERRING_PHYSICIAN" add="true" tag="0008,0090"/>
            <Item name="LBL_RADIOLOGIST"         add="true" code="J-06170" scheme="SNM3"/>
            <Item name="LBL_CARDIOLOGIST"        add="true" code="J-0612B" scheme="SNM3"/>
            <Item name="LBL_ENDOSCOPIST"         add="false" code="" scheme=""/>
            <Item name="LBL_TECHNOLOGIST"        add="false" code="J-001CE" scheme="SNM3"/>
            <Item name="LBL_REGISTERED_NURSE"    add="false" code="J-00007" scheme="SNM3"/>
        </PhysicianInfo>
    </Demographics>
<!-- Generic Message -->
    <GenericMessages>
    </GenericMessages>
