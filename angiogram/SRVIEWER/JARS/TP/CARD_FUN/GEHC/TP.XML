    </PatientQuestions>
<!-- Diagram list -->
    <Diagrams align="left">
    </Diagrams>
<!-- Image settings -->
    <Images manual="true" automatic="true" columns="3">
        <HTMLImageSize original="true" unit="%">100</HTMLImageSize>
    </Images>
<!-- Physician list with signatures -->
    <Physicians align="left">
    </Physicians>
<!-- Report blocks -->
    <Sections>
        <Section id="0" name="LBL_HEADER" type="HEADER">
            <Section name="LBL_LOGO_NAME_ADDRESS" type="LOGO_NAME_ADDRESS"/>
            <Section name="LBL_PHYSICIAN_LIST" type="PHYSICIAN_LIST"/>
            <Section name="LBL_REPORT_TITLE" type="REPORT_TITLE"/>
        </Section>
        <Section id="1" name="LBL_PATIENT_DEMOGRAPHICS" type="PATIENT_DEMOGRAPHICS">
            <Section name="LBL_IDENTIFICATION" type="IDENTIFICATION"/>
            <Section name="LBL_MEDICAL_HISTORY" type="MEDICAL_HISTORY"/>
            <Section name="LBL_PHYSICIAN_INFO" type="PHYSICIAN_INFO"/>
        </Section>
        <Section id="3" name="LBL_PREDECESSOR_DOCUMENTS" type="PREDECESSOR_DOCUMENTS"/>
